# GitHub Packages registry for @gregoiref scoped packages.
# GITHUB_TOKEN is provided automatically by GitHub Actions workflows
# (requires `packages: read` permission in the workflow).
# For local development, set GITHUB_TOKEN to a personal access token
# with `read:packages` scope, or run `gh auth token` to obtain one.
@gregoiref:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
